GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

JWT_SECRET=your_jwt_secret_min_32_chars
COOKIE_SECRET=your_cookie_secret_min_32_chars

# Redis — required for multi-instance deployments (ASG).
# In production, use your ElastiCache Redis primary endpoint.
# Format: redis://host:6379  or  rediss://host:6379 (TLS)
REDIS_URL=redis://localhost:6379

PORT=3000
NODE_ENV=development
BACKEND_URL="http://localhost:3000"

ALLOWED_HOSTS="http://localhost:5173,https://example.com"
AUTH_REDIRECT_URL="http://localhost:5173/game/random"
FRONTEND_URL="http://localhost:5173"