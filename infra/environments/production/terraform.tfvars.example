# ─────────────────────────────────────────────────────────────────────────────
# infra/environments/production/terraform.tfvars
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

aws_region = "ap-south-1"

# Google OAuth — use your production OAuth credentials
google_client_id     = "your-prod-google-client-id.apps.googleusercontent.com"
google_client_secret = "your-prod-google-client-secret"

# GitHub OAuth — production app
github_client_id     = "your-prod-github-client-id"
github_client_secret = "your-prod-github-client-secret"

# JWT / Cookie secrets — DIFFERENT from staging, generate with: openssl rand -base64 48
jwt_secret    = "generate-a-strong-random-secret-min-32-chars"
cookie_secret = "generate-a-different-strong-random-secret-min-32-chars"
